{
  "name": "salvia",
  "version": "0.1.1",
  "description": "一个输入框搞定视频、音乐、番剧、小说下载：终端界面 + 网页界面",
  "keywords": ["downloader", "bilibili", "youtube", "music", "anime", "novel", "legado", "tui", "cli"],
  "homepage": "https://github.com/during-morning/Salvia#readme",
  "repository": { "type": "git", "url": "git+https://github.com/during-morning/Salvia.git" },
  "bugs": { "url": "https://github.com/during-morning/Salvia/issues" },
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch packages/app/src/serve.ts\" \"npm run dev -w @salvia/web\"",
    "server": "tsx packages/app/src/serve.ts",
    "cli": "tsx packages/cli/src/main.tsx",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:demo": "concurrently -k -n server,web \"tsx watch packages/app/src/serve.ts --demo\" \"npm run dev -w @salvia/web\"",
    "build": "node scripts/build.mjs",
    "build:bundle": "node scripts/build.mjs --no-exe"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@types/node": "^26.6.4",
    "@xmldom/xmldom": "^0.9.12",
    "@xterm/headless": "^6.0.0",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "ink-testing-library": "^4.0.0",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.28.2": true
  },
  "bin": {
    "salvia": "packages/cli/bin/salvia.mjs"
  }
}
